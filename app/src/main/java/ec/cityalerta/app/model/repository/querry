CREATE OR REPLACE FUNCTION get_barrios()
RETURNS TABLE (
  id uuid,
  ciudad_id uuid,
  nombre text,
  nivel_peligrosidad text,
  perimetro json,
  created_at timestamptz,
  updated_at timestamptz
)
AS $$
SELECT
  id,
  ciudad_id,
  nombre,
  nivel_peligrosidad,
  CASE
    WHEN perimetro IS NOT NULL
    THEN ST_AsGeoJSON(perimetro)::json
    ELSE NULL
  END,
  created_at,
  updated_at
FROM barrio;
$$ LANGUAGE sql STABLE;


CREATE OR REPLACE FUNCTION get_barrio_by_id(p_id uuid)
RETURNS TABLE (
  id uuid,
  ciudad_id uuid,
  nombre text,
  nivel_peligrosidad text,
  perimetro json,
  created_at timestamptz,
  updated_at timestamptz
)
AS $$
BEGIN
  IF p_id IS NULL THEN
    RAISE EXCEPTION 'El ID del barrio no puede ser nulo';
  END IF;

  RETURN QUERY
  SELECT
    b.id,
    b.ciudad_id,
    b.nombre,
    b.nivel_peligrosidad,
    CASE
      WHEN b.perimetro IS NOT NULL
      THEN ST_AsGeoJSON(b.perimetro)::json
      ELSE NULL
    END,
    b.created_at,
    b.updated_at
  FROM barrio b
  WHERE b.id = p_id;

  IF NOT FOUND THEN
    RAISE EXCEPTION 'Barrio con ID % no encontrado', p_id;
  END IF;
END;
$$ LANGUAGE plpgsql;


