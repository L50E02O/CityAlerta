CREATE OR REPLACE FUNCTION create_ciudad(
  p_nombre text,
  p_pais text,
  p_geojson json,
  p_centro_lat double precision,
  p_centro_lng double precision
)
RETURNS uuid AS $$
DECLARE new_id uuid;
BEGIN
  IF p_nombre IS NULL OR p_nombre = '' THEN
    RAISE EXCEPTION 'El nombre de la ciudad no puede estar vacío';
  END IF;

  IF p_pais IS NULL OR p_pais = '' THEN
    RAISE EXCEPTION 'El pais de la ciudad no puede estar vacío';
  END IF;

  IF p_centro_lat IS NULL THEN
    RAISE EXCEPTION 'La latitud central no puede ser nula';
  END IF;

  IF p_centro_lng IS NULL THEN
    RAISE EXCEPTION 'La longitud central no puede ser nula';
  END IF;

  INSERT INTO ciudad (
    nombre,
    pais,
    geojson,
    centro_lat,
    centro_lng
  )
  VALUES (
    p_nombre,
    p_pais,
    CASE
      WHEN p_geojson IS NOT NULL
      THEN ST_SetSRID(ST_GeomFromGeoJSON(p_geojson::text), 4326)
      ELSE NULL
    END,
    p_centro_lat,
    p_centro_lng
  )
  RETURNING id INTO new_id;

  RETURN new_id;
END;
$$ LANGUAGE plpgsql;


CREATE OR REPLACE FUNCTION update_ciudad(
  p_id uuid,
  p_nombre text,
  p_pais text,
  p_geojson json,
  p_centro_lat double precision,
  p_centro_lng double precision
)
RETURNS void AS $$
BEGIN
  IF p_id IS NULL THEN
    RAISE EXCEPTION 'El ID de la ciudad no puede ser nulo';
  END IF;

  IF NOT EXISTS (SELECT 1 FROM ciudad WHERE id = p_id) THEN
    RAISE EXCEPTION 'Ciudad con ID % no encontrada', p_id;
  END IF;

  IF p_nombre = '' THEN
    RAISE EXCEPTION 'El nombre de la ciudad no puede estar vacío';
  END IF;

  IF p_pais = '' THEN
    RAISE EXCEPTION 'El pais de la ciudad no puede estar vacío';
  END IF;

  UPDATE ciudad
  SET
    nombre = COALESCE(p_nombre, nombre),
    pais = COALESCE(p_pais, pais),
    geojson = CASE
      WHEN p_geojson IS NOT NULL
      THEN ST_SetSRID(ST_GeomFromGeoJSON(p_geojson::text), 4326)
      ELSE geojson
    END,
    centro_lat = COALESCE(p_centro_lat, centro_lat),
    centro_lng = COALESCE(p_centro_lng, centro_lng)
  WHERE id = p_id;
END;
$$ LANGUAGE plpgsql;


CREATE OR REPLACE FUNCTION delete_ciudad(p_id uuid)
RETURNS void AS $$
BEGIN
  IF p_id IS NULL THEN
    RAISE EXCEPTION 'El ID de la ciudad no puede ser nulo';
  END IF;

  IF NOT EXISTS (SELECT 1 FROM ciudad WHERE id = p_id) THEN
    RAISE EXCEPTION 'Ciudad con ID % no encontrada', p_id;
  END IF;

  DELETE FROM ciudad WHERE id = p_id;
END;
$$ LANGUAGE plpgsql;


CREATE OR REPLACE FUNCTION create_barrio(
  p_ciudad_id uuid,
  p_nombre text,
  p_nivel_peligrosidad text,
  p_geojson json
)
RETURNS uuid AS $$
DECLARE new_id uuid;
BEGIN
  IF p_ciudad_id IS NULL THEN
    RAISE EXCEPTION 'El ID de la ciudad no puede ser nulo';
  END IF;

  IF p_nombre IS NULL OR p_nombre = '' THEN
    RAISE EXCEPTION 'El nombre del barrio no puede estar vacío';
  END IF;

  IF p_nivel_peligrosidad IS NULL OR p_nivel_peligrosidad = '' THEN
    RAISE EXCEPTION 'El nivel de peligrosidad no puede estar vacío';
  END IF;

  IF p_geojson IS NULL THEN
    RAISE EXCEPTION 'El perímetro GeoJSON no puede ser nulo';
  END IF;

  INSERT INTO barrio (
    ciudad_id,
    nombre,
    nivel_peligrosidad,
    perimetro
  )
  VALUES (
    p_ciudad_id,
    p_nombre,
    p_nivel_peligrosidad,
    ST_SetSRID(ST_GeomFromGeoJSON(p_geojson::text), 4326)
  )
  RETURNING id INTO new_id;

  RETURN new_id;
END;
$$ LANGUAGE plpgsql;


